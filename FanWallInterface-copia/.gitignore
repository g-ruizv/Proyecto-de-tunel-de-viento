# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
*.egg-info/
*.pyc
*.pyd
*.pyo

# ==========================================
# Entorno virtual (NO se sube a GitHub)
# ==========================================
venv/
env/
.env/
.venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# Node.js (NO se sube node_modules/)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# PERO sí se suben los archivos de configuración de Node
!package.json
!package-lock.json

# Mantener estructura de carpetas (archivos .keep)
!**/.keep

# ==========================================
# Variables de entorno (NO se suben)
# ==========================================
.env
.env.local
.env.*.local
*.env

# PERO sí se sube el ejemplo (si existe)
!.env.example

# ==========================================
# Base de datos
# ==========================================
*.db
*.sqlite
*.sqlite3
*.db-journal

# ==========================================
# Archivos de sistema (Windows/Linux/Mac)
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.swp
*.swo
*~
*.bak
*.log

# ==========================================
# IDE y editores
# ==========================================
.vscode/
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ==========================================
# Archivos de compilación de Arduino
# ==========================================
*.ino.bin
*.ino.elf
*.ino.map
*.ino.bootloader.bin
*.ino.partitions.bin
*.ino.merged.bin
*.ino.with_bootloader.bin

# ==========================================
# Archivos de cobertura y pruebas
# ==========================================
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.pytest_cache/

# ==========================================
# Documentación generada
# ==========================================
docs/_build/
site/

# ==========================================
# Archivos de logs
# ==========================================
*.pid
*.seed
*.pid.lock

# ==========================================
# Archivos de migración (opcional, según proyecto)
# ==========================================
# migrations/  # Descomentar si NO quieres subir migraciones

# ==========================================
# Archivos específicos del proyecto
# ==========================================
# Archivos de configuración local (no compartir)
config_local.py
settings_local.py

# ==========================================
# Archivos estáticos generados (NO node_modules, ya incluido)
# Pero SÍ se suben tus archivos CSS/JS propios
# ==========================================
# Esta sección asegura que NO se ignoren tus archivos propios
!app/static/css/
!app/static/js/
!app/static/favicon.ico

# ==========================================
# ¡IMPORTANTE! NO ignorar index.html
# ==========================================
# Asegurar que los archivos HTML (especialmente index.html) NO sean ignorados
# Si hay una regla que ignora *.html, se desactiva aquí:
!*.html
!app/templates/*.html

# ==========================================
# Archivos de respaldo automático
# ==========================================
*~
*.orig
*.rej